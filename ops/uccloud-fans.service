[Unit]
Description=UCcloud restricted hardware fan bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=cloud-portal
ExecStart=/usr/bin/python3 /usr/local/lib/uccloud/fan_broker.py
RuntimeDirectory=uccloud-fans
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/uccloud-fans
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
TasksMax=32
MemoryMax=128M

[Install]
WantedBy=multi-user.target
