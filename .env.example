PORTAL_BIND=127.0.0.1
PORTAL_PORT=8088
PORTAL_DB=/var/lib/cloud-portal/portal.db
PORTAL_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_COOKIE_SECURE=false
PORTAL_SESSION_HOURS=12
PORTAL_LOGIN_IP_ATTEMPTS_PER_MINUTE=120
PORTAL_REGISTRATIONS_PER_HOUR=1000
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_EMAIL=admin@example.invalid
PORTAL_ADMIN_PASSWORD=replace-with-random-secret

OS_AUTH_URL=https://172.141.0.231:5000/v3
OS_USERNAME=admin
OS_PASSWORD=replace-with-openstack-admin-password
OS_SERVICE_USERNAME=portal-service
OS_SERVICE_PASSWORD=replace-with-separate-random-secret
OS_PROJECT_NAME=admin
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=RegionOne
OS_INTERFACE=public
OS_VERIFY=true

PORTAL_SHARED_ROUTER=router1
PORTAL_ALLOWED_IMAGES=ubuntu-24.04
PORTAL_ALLOWED_FLAVORS=small,medium,large
PORTAL_DNS_SERVERS=211.220.216.12,168.126.63.1
